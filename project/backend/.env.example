# Copy this file to .env and fill in real values. Never commit .env.

ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# Supabase gives you this connection string on the project's Database settings page
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxx.supabase.co:5432/postgres

# https://openweathermap.org/api — free tier is enough for development
OPENWEATHER_API_KEY=your_openweathermap_key

# https://developer.tomtom.com — free tier is enough for development
TOMTOM_API_KEY=your_tomtom_key

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Paths to the ML artifacts — relative to the backend/ folder (where you run uvicorn from).
# Since ml_model/ sits next to backend/ in this project, we go up one level with ../
MODEL_ARTIFACT_PATH=../ml_model/model_artifacts/best_model.joblib
SHAP_EXPLAINER_PATH=../ml_model/model_artifacts/explainer.joblib
